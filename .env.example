# Copy to .env and fill in. Never commit .env.

# --- Jev / TypeSafe ---------------------------------------------------------
# "typesafe" = real API (needs a key from https://console.typesafe.ai/keys)
# "mock"     = OFFLINE keyword mock. Its output is NOT Jev output.
JEV_BACKEND=
TYPESAFE_API_KEY=
# Pin a versioned id (e.g. jev-1.13.0) once your thresholds are tuned.
JEV_MODEL=
JEV_TIMEOUT_SECONDS=
JEV_MAX_RETRIES=
JEV_RETRY_BUDGET_SECONDS=

# --- Automation policy (application choices, NOT TypeSafe recommendations) --
AUTO_ROUTE_MIN_CONFIDENCE=
MIN_TOP2_MARGIN=
PRIORITY_MIN_CONFIDENCE=
HUMAN_REVIEW_NOUL_THRESHOLD=
CRITICAL_ESCALATION_PROBABILITY=
MANDATORY_REVIEW_PRIORITIES=

# --- Limits, privacy, infrastructure ----------------------------------------
MAX_MESSAGE_CHARS=
REDACT_PII=
DATABASE_URL=
LOG_LEVEL=
